# LLM gateway (BMS AI Hub). Service appends /anthropic to the base URL.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-opus-4-8

# Must match the REST API so its JWTs verify here.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# REST API base the agent's tools call for project/run/sample data.
NGS360_API_URL=http://localhost:3000/api/v1

# CORS: the frontend origin allowed to call this service.
CLIENT_ORIGIN=http://localhost:5173
